{
  "name": "figmalint",
  "version": "2.5.3",
  "description": "FigmaLint - AI-powered component linting for Figma that audits design system compliance, MCP compatibility, and accessibility, and generates developer handoff documentation. Supports Anthropic, OpenAI, Google, and GitHub Models providers.",
  "main": "dist/code.js",
  "scripts": {
    "build": "npm run bundle",
    "bundle": "esbuild src/code.ts --bundle --outfile=dist/code.js --platform=neutral --target=es2017 --format=iife --loader:.ts=ts",
    "dev": "npm run bundle -- --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "esbuild scripts/selfcheck.ts --bundle --platform=node | node -",
    "lint": "tsc --noEmit",
    "prebuild": "npm run clean"
  },
  "keywords": [
    "figma",
    "plugin",
    "linter",
    "lint",
    "audit",
    "mcp",
    "design-system",
    "accessibility",
    "tokens",
    "developer-handoff"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@figma/plugin-typings": "^1.114.0",
    "esbuild": "^0.25.5",
    "typescript": "^5.6.3"
  },
  "files": [
    "dist/**/*"
  ]
}
